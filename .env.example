# Copy to .env and fill in (never commit .env).
# Used by scripts/publish-template.js and the Lambda locally.

AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
# alias also accepted: AWS_S3_BUCKET=
# Optional — omit to use ~/.aws credentials / AWS_PROFILE:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=
# alias also accepted: SUPABASE_SERVICE_ROLE_KEY=

MONGO_URI=
